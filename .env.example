# ============================================================
# KnowHub(知枢) 环境配置模板 —— 复制为 .env 并填入真实值
# 网关采用 OpenAI 兼容协议（/v1/chat/completions 与 /v1/embeddings）
# ============================================================

# ---------- LLM 网关 ----------
LLM_API_KEY=sk-your-api-key
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# ---------- 对话模型（按优先级依次尝试，主模型失败自动降级） ----------
LLM_MODEL1=qwen-max
LLM_MODEL2=glm-5
#LLM_MODEL3=deepseek-v4-flash-0731
LLM_MODEL4=qwen3-coder-plus
LLM_MODEL5=qwen-plus-0112

# ---------- 向量化模型 ----------
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_MODEL1=qwen3.7-text-embedding

# ---------- 安全（生产必须修改） ----------
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# ---------- 可选配置 ----------
# REGISTRATION_ENABLED=true          # 自助注册开关
# TRASH_RETENTION_DAYS=30            # 回收站自动清理天数(0=关闭)
# KB_MAX_DOCS=0                      # 每库文档数上限(0=不限)
